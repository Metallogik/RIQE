# --- Data: never on GitHub --------------------------------------------------
# The corpus comes from TCIA (CC BY 4.0) and is re-downloaded with
# scripts/download_corpus.py. The repository carries its *identity*
# (corpus/corpus_manifest.json: UIDs and SHA-256 of every slice), not pixels.
data/
*.dcm
*.zip
*.npy
*.npz
*.parquet
*.log

# The released model itself is small and belongs in the repository.
!artifacts/riqe-v1.0.npz

# --- Working material, not part of the public release -----------------------
# Paper sources (published separately), internal working notes, experiment
# outputs (regenerated by scripts/run_pipeline.sh).
paper/
docs/
experiments/
logs/
artifacts/verify_ok.txt
corpus/recon.json
corpus/recon_slice_sample.json
scripts/recon_series_metadata.py
scripts/sample_slices.py

# --- Environment -------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
